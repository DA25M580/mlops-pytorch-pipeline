# -- Stage 1: builder (installs deps) -----------------------------------------
# Multi-stage training image
FROM python:3.11-slim AS builder
WORKDIR /app

COPY requirements/train.txt .
RUN pip install --no-cache-dir --prefix=/install -r train.txt


# -- Stage 2: runtime ----------------------------------------------------------
# Multi-stage training image
FROM python:3.11-slim
WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy source
COPY src/ ./src/
COPY configs/ ./configs/

# Data and checkpoint dirs (mounted as PVCs in k8s)
RUN mkdir -p /app/data /app/checkpoints

ENV CONFIG_PATH=/app/configs/training_config.yaml \
    PYTHONUNBUFFERED=1

CMD ["python", "src/train.py"]
